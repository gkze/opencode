# vi: ft=bash
# shellcheck shell=bash source=/dev/null

if ! has nix_direnv_version || ! nix_direnv_version 3.1.1; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.1/direnvrc" "sha256-p+fzQdrms/hDa7g+soShAybJNo4bN4SIAeSfqNKgD5I=" || exit 1
fi

nix_direnv_disallow_fallback

watch_file flake.nix
watch_file flake.lock
watch_file bun.lock

for package_json in package.json packages/*/package.json packages/*/*/package.json sdks/*/package.json; do
  [ -f "${package_json}" ] && watch_file "${package_json}"
done

if ! use flake .; then
  echo "direnv: nix flake failed to load. Fix flake.nix and press Enter to retry." >&2
  # source_env can swallow a returned failure; exit the direnv evaluation shell.
  exit 1
fi

PATH_add node_modules/.bin

source_env_if_exists "${PWD}/.envrc.local"
